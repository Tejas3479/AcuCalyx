# AcuCalyx Production Deployment Environment Variables
# FDA Section 524B & HIPAA PS 3.15 Conforming Configuration

ACUCALYX_ENV=production
ACUCALYX_REQUIRE_AUTH=1
ACUCALYX_AUTH_SECRET=generate_strong_secret_with_openssl_rand_hex_32
ACUCALYX_DEID_SECRET=generate_strong_secret_with_openssl_rand_hex_32
ACUCALYX_LOG_LEVEL=INFO
